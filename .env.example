# ---------------------------------------------------------------------------
# Buffett/Graham Evaluator — environment configuration
# Copy this file to ".env" and fill in any keys you have. ALL keys are OPTIONAL.
# The app works with ZERO keys using free SEC EDGAR data; keys unlock prices
# and supplemental fundamentals from third-party providers.
#
# NEVER commit your real .env file. It is git-ignored by default.
# ---------------------------------------------------------------------------

# Server
PORT=3000
LOG_LEVEL=info            # debug | info | warn | error

# SEC EDGAR requires a descriptive User-Agent with contact info (their policy).
# Put your app name + email here. No account or key needed.
SEC_USER_AGENT="BuffettGrahamEvaluator/1.0 (your-email@example.com)"

# Optional third-party providers (used for prices + supplemental fundamentals).
# Leave blank if you don't have them — the app degrades gracefully.
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
TIINGO_API_KEY=
POLYGON_API_KEY=

# Cache time-to-live in hours for fundamental data (filings change rarely).
CACHE_TTL_HOURS=168
# Cache TTL in hours for price quotes (more volatile).
PRICE_CACHE_TTL_HOURS=12
