# Copy to ".env" and fill in. See the setup steps in the docstring at the top
# of strava_google_sheets_agent.py for how to obtain each value.

# Strava API app (developers.strava.com/settings) + one-time OAuth exchange
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# GCP service account JSON key, shared as an editor on the target sheet
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Target spreadsheet
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Training Log
